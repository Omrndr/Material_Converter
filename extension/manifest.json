{
  "manifest_version": 3,
  "name": "MatWeb → XML",
  "version": "0.1.0",
  "description": "MatWeb malzeme veri sayfasını tek tıkla XML dosyası olarak indirir.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_title": "MatWeb sayfasını XML olarak indir",
    "default_icon": "icons/icon.svg"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["activeTab", "scripting", "downloads"],
  "browser_specific_settings": {
    "gecko": {
      "id": "matweb-xml@malzeme-donusturucu",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
