{
  "manifest_version": 3,
  "name": "MatWeb → ANSYS",
  "version": "0.2.0",
  "description": "MatWeb malzeme veri sayfalarını tek tıkla ANSYS Engineering Data kütüphanesine (XML) ekler.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_title": "MatWeb → ANSYS kütüphanesi",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "matweb-xml@malzeme-donusturucu",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
